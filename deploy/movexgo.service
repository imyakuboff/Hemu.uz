# /etc/systemd/system/movexgo.service
# O'rnatish: sudo cp deploy/movexgo.service /etc/systemd/system/ && sudo systemctl enable --now movexgo
[Unit]
Description=MovexGo Market
After=network.target

[Service]
Type=simple
User=movexgo
WorkingDirectory=/opt/movexgo
EnvironmentFile=/opt/movexgo/.env
Environment=NODE_ENV=production
ExecStart=/usr/bin/node --disable-warning=ExperimentalWarning src/server.js
Restart=always
RestartSec=3
# Xavfsizlik
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/opt/movexgo/data
PrivateTmp=true

[Install]
WantedBy=multi-user.target
