PORT=4700
NODE_ENV=development
# Production'da albatta uzun tasodifiy qiymat qo'ying
APP_SECRET=change-me-to-a-long-random-string
# Saytning tashqi manzili: to'lovdan qaytish, Telegram tugmalari, sitemap (masalan https://movexgo.uz)
SITE_URL=
# Rasm havolalari uchun tashqi manzil (odatda SITE_URL bilan bir xil)
PUBLIC_URL=
# Vergul bilan: https://movexgo.uz,https://admin.movexgo.uz  (* = hammaga)
CORS_ORIGINS=*
DEFAULT_LANG=uz
DEFAULT_COUNTRY=UZ
# 1 = SMS kodi javobda qaytadi (faqat dev uchun!)
OTP_DEV_ECHO=1
SESSION_TTL_DAYS=60
AUTO_APPROVE_VERIFIED=1
# 1 = har 6 soatda cbu.uz dan valyuta kurslarini yangilash
RATES_AUTO_SYNC=0
# DB_FILE=./data/movexgo.db
# UPLOAD_DIR=./data/uploads
SMS_PROVIDER=log

# ---------- To'lovlar ----------
# 1 = "Тестовая оплата" (pul yechilmaydi). Productionda 0 qiling!
PAYMENTS_DEV=1
# Click (my.click.uz kabineti → Servis sozlamalari)
#   Prepare URL:  https://SAYT/api/v1/pay/click/prepare
#   Complete URL: https://SAYT/api/v1/pay/click/complete
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_MERCHANT_USER_ID=
CLICK_SECRET_KEY=
# Payme (business.payme.uz → Kassa → Endpoint: https://SAYT/api/v1/pay/payme, hisob maydoni: payment_id)
PAYME_MERCHANT_ID=
PAYME_KEY=
# Sinov kassasi uchun: https://checkout.test.paycom.uz
PAYME_CHECKOUT_URL=https://checkout.paycom.uz

# Narxlar (USD; to'lovda mahalliy valyutaga o'giriladi)
PRICE_TOP_USD=5
PRICE_HIGHLIGHT_USD=3
PRICE_COMBO_USD=7
PROMO_DAYS=7
PRICE_BUSINESS_USD=49
PRICE_INSPECTION_USD=25
FREE_LISTING_LIMIT=10
BUSINESS_TOP_CREDITS=3
ESCROW_FEE_PCT=1.5

# ---------- Telegram ----------
# @BotFather → /newbot → token
TELEGRAM_BOT_TOKEN=
